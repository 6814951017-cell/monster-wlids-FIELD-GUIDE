# Copy to server/.env for local development. Never commit the real .env.
PORT=5000
# MongoDB Atlas: include the database name after the host, e.g. ...mongodb.net/mh_data?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mh_data?retryWrites=true&w=majority
# Long random string; required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Optional locally: lets the admin forms upload images to Vercel Blob during development.
# On Vercel, connecting a Blob store sets BLOB_STORE_ID (or this token) for you.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
