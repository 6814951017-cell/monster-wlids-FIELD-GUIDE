{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__apiPath=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
